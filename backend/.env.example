# Copy this file to backend/.env for local development. Never commit real secrets.
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./apiradar.db
SECRET_KEY=replace-with-a-long-random-secret-before-deploying
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:5173"]

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID= 
GOOGLE_CLIENT_SECRET= 

# GitHub OAuth App credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend sends new-browser sign-in alerts. EMAIL_FROM must be a verified sender.
RESEND_API_KEY=
EMAIL_FROM=

# Optional provider ingestion/model settings
OPENAI_API_KEY=
GITHUB_TOKEN=
